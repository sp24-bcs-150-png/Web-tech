<div style="padding: 40px; font-family: 'Arial', sans-serif; text-align: center;">
    <h1 style="color: #333;">📊 Real-Time Sales Dashboard</h1>
    <p>This page automatically checks for updated numbers every 10 seconds!</p>

    <div style="display: flex; justify-content: center; gap: 20px; margin-top: 30px;">
        
        <div style="background: #2ec4b6; color: white; padding: 30px; border-radius: 12px; width: 250px; box-shadow: 0 4px 8px rgba(0,0,0,0.1);">
            <h3>Total Revenue</h3>
            <h2 id="revenue-box" style="font-size: 2rem;">
                $<%= data.totalRevenue %>
            </h2>
        </div>

        <div style="background: #e71d36; color: white; padding: 30px; border-radius: 12px; width: 250px; box-shadow: 0 4px 8px rgba(0,0,0,0.1);">
            <h3>Total Orders</h3>
            <h2 id="orders-box" style="font-size: 2rem;">
                <%= data.totalOrders %>
            </h2>
        </div>

    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    // This function requests updated numbers from the server every 10 seconds
    function loadLatestNumbers() {

        $.getJSON('/api/sales-data', function(updatedData) {

            // Update the numbers on the screen without refreshing the page
            $('#revenue-box').text('$' + updatedData.totalRevenue);
            $('#orders-box').text(updatedData.totalOrders);

            console.log("New numbers received from the database!");
        });
    }

    // Tell the browser:
    // "Run the above function every 10,000 milliseconds (10 seconds)"
    setInterval(loadLatestNumbers, 10000);
</script>