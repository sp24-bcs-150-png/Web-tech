<div class="card shadow-sm p-4 bg-white">

    <h3 class="mb-4 text-secondary border-bottom pb-2">
        📦 Live Product Inventory
    </h3>

    <div class="table-responsive">

        <table class="table table-hover table-bordered align-middle">

            <thead class="table-dark">
                <tr>
                    <th style="width: 100px;">Image</th>
                    <th>Product Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock Level</th>
                    <th class="text-center" style="width: 200px;">Actions</th>
                </tr>
            </thead>

            <tbody>

                <% if (products.length === 0) { %>

                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            Database is empty! Click the button above to add a new product.
                        </td>
                    </tr>

                <% } %>

                <% products.forEach(product => { %>

                    <tr>

                        <td>
                            <img 
                                src="<%= product.imagePath %>" 
                                alt="Product"
                                class="img-thumbnail"
                                style="width: 70px; height: 70px; object-fit: cover;">
                        </td>

                        <td class="fw-bold text-dark">
                            <%= product.name %>
                        </td>

                        <td>
                            <span class="badge bg-secondary">
                                <%= product.category %>
                            </span>
                        </td>

                        <td class="text-success fw-bold">
                            $<%= product.price %>
                        </td>

                        <td>
                            <% if (product.stock === 0) { %>

                                <span class="text-danger fw-bold">
                                    Out of Stock
                                </span>

                            <% } else { %>

                                <span class="text-muted">
                                    <%= product.stock %> units available
                                </span>

                            <% } %>
                        </td>

                        <td class="text-center">

                            <a href="/admin/edit/<%= product._id %>"
                               class="btn btn-sm btn-warning me-2">
                                ✏️ Edit
                            </a>

                            <a href="/admin/delete/<%= product._id %>"
                               class="btn btn-sm btn-danger"
                               onclick="return confirm('🚨 Are you sure you want to permanently delete this product from the database?');">
                                🗑️ Delete
                            </a>

                        </td>

                    </tr>

                <% }) %>

            </tbody>

        </table>

    </div>

</div>