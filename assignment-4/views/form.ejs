<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow p-4 bg-white">
            <h3 class="mb-4 text-primary">
                <%= isEdit ? '✏️ Edit Product Details' : '➕ Add Product To Database' %>
            </h3>

            <div id="validation-error" class="alert alert-danger d-none">
                Error! No field should be empty and Price/Stock must be valid.
            </div>

            <form id="crudForm"
                action="<%= isEdit ? '/admin/edit/' + product._id : '/admin/add' %>"
                method="POST"
                enctype="multipart/form-data"
                onsubmit="return handleValidation()">

                <div class="mb-3">
                    <label class="form-label fw-bold">Product Name</label>
                    <input type="text" id="pName" name="name" class="form-control"
                        value="<%= isEdit ? product.name : '' %>">
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Category</label>

                    <select id="pCategory" name="category" class="form-select">
                        <option value="">-- Choose Category --</option>

                        <option value="Electronics"
                            <%= isEdit && product.category === 'Electronics' ? 'selected' : '' %>>
                            Electronics
                        </option>

                        <option value="Fashion"
                            <%= isEdit && product.category === 'Fashion' ? 'selected' : '' %>>
                            Fashion
                        </option>

                        <option value="Home"
                            <%= isEdit && product.category === 'Home' ? 'selected' : '' %>>
                            Home
                        </option>
                    </select>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Price ($)</label>

                        <input type="number" id="pPrice" name="price"
                            class="form-control"
                            value="<%= isEdit ? product.price : '' %>"
                            min="1">
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Stock Count</label>

                        <input type="number" id="pStock" name="stock"
                            class="form-control"
                            value="<%= isEdit ? product.stock : '' %>"
                            min="0">
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Upload Product Image</label>

                    <input type="file" id="pImage" name="productImage"
                        class="form-control">

                    <% if (isEdit) { %>
                        <div class="form-text text-muted mt-1">
                            If you do not select a new image, the old image will remain unchanged.
                        </div>
                    <% } %>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        Save To Database
                    </button>

                    <a href="/admin" class="btn btn-secondary w-100">
                        Back To Dashboard
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function handleValidation() {

    const name = document.getElementById('pName').value.trim();
    const category = document.getElementById('pCategory').value;
    const price = document.getElementById('pPrice').value;
    const stock = document.getElementById('pStock').value;
    const image = document.getElementById('pImage').files.length;

    const isEditMode = "<%= isEdit %>" === "true";

    // Check if fields are empty or image is missing for new product
    if (!name || !category || !price || !stock || (!isEditMode && image === 0)) {

        document.getElementById('validation-error')
            .classList.remove('d-none');

        window.scrollTo(0, 0);

        return false;
    }

    return true;
}
</script>