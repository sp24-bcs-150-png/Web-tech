<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">🔐 Auth App</a>
            <div class="navbar-nav ms-auto">
                <% if (user) { %>
                    <span class="nav-link text-warning fw-semibold">Welcome, <%= user.name %> (<%= user.role %>)</span>
                    <% if (user.role === 'admin') { %> 
                        <a class="nav-item nav-link text-info text-decoration-underline" href="/admin">Admin Panel</a> 
                    <% } %>
                    <a class="nav-item nav-link btn btn-sm btn-outline-danger ms-2 px-3 text-white" href="/logout">Logout</a>
                <% } else { %>
                    <a class="nav-item nav-link" href="/login">Login</a>
                    <a class="nav-item nav-link" href="/register">Register</a>
                <% } %>
            </div>
        </div>
    </nav>

    <div class="container">
        <% if (success_msg && success_msg.length > 0) { %> 
            <div class="alert alert-success alert-dismissible fade show"><%= success_msg %></div> 
        <% } %>
        <% if (error_msg && error_msg.length > 0) { %> 
            <div class="alert alert-danger alert-dismissible fade show"><%= error_msg %></div> 
        <% } %>
        
        <%- body %>
    </div>

</body>
</html>